// GPU-oldali port a WorldGen.Core determinisztikus lánc (Threefry4x64 ->
// DeterministicRandom -> FractalNoise/DomainWarp -> PlateGeneration/
// PlateBoundaryEffect/CrustElevation -> OrbitalMechanics -> Temperature ->
// BiomeClassification) egy alhalmazáról, KIZÁRÓLAG a Unity-viewer
// tile-klasszifikációjához (szín/eleváció a megjelenítéshez).
//
// FONTOS, DOKUMENTÁLT ELTÉRÉS a CPU-s (WorldGen.Core, double) lánctól:
//   1. Itt MINDEN float32 (HLSL nem garantál platformfüggetlen double-t),
//      a CPU lánc double-lel dolgozik - ld. docs/04-decisions.md a
//      GPU-számítás ND-jéhez. Ez a viewer megjelenítő rétege, NEM a
//      perzisztált világmodell (CLAUDE.md I1/I2 a `src/WorldGen.Core`-ra
//      vonatkozik, ez itt tisztán render-oldali reprodukció).
//   2. A [0,1) egyenletes minta a Threefry-blokk FELSŐ 32 BITJÉBŐL jön
//      (nem a CPU-s "felső 53 bit"-ből, ld. DeterministicRandom.Sample) -
//      float32 mantissza úgyis csak 24 bitet tudna hasznosítani, és ez a
//      döntés NEM befolyásolja az eloszlás egyenletességét (a Threefry
//      kimenete pszeudovéletlen permutáció, minden bitje egyformán "jó").
//   3. A lemez-magok (PlateGeneration.GenerateSeeds) és a kéreg-típus
//      (CrustElevation.IsOceanic) TOVÁBBRA IS CPU-n számolódik (olcsó,
//      plateCount-szor fut) és bufferként jön be - a GPU csak a per-tile
//      drága láncot (fbm/ridged/warp/boundary/temperature) váltja ki.
//
// A Threefry4x64 64-bites aritmetika-emulációja (uint2 Lo/Hi pár) a
// scratchpad Bench.cs-ben 9/9 hivatalos Random123 KAT-vektorral
// ellenőrizve, MIELŐTT ide került - ld. tools/reference/kat_vectors.

#pragma kernel CSClassifyTiles
#pragma kernel CSGenerateTerrainGeometry

// ---- Bemenet ----
StructuredBuffer<float3> _positions;      // egységvektor pozíciók, count = _tileCount
StructuredBuffer<float3> _plateSeeds;     // lemez-mag egységvektorok, count = _plateCount
StructuredBuffer<uint> _plateIsOceanic;   // 0/1 lemezenként, count = _plateCount
StructuredBuffer<float4> _craters;        // xyz = pozíció, w = cosAngularRadius, count = _craterCount
StructuredBuffer<float> _craterDepths;    // méter, count = _craterCount

uint2 _worldSeed;      // (Lo, Hi) a worldSeed ulong-ból
uint _plateCount;
uint _craterCount;
uint _tileCount;
// A Dispatch() egy dimenzioban max 65535 thread-groupot enged (D3D limit),
// ami nagy tile-szamnal (pl. a teljes base-reteg egy dispatch-ben)
// tullepheto - ezert 2D racsra dispatch-elunk, es ez a mezo mondja meg a
// racs SZELESSEGET (groupsX), hogy a group-ID-bol vissza tudjuk fejteni a
// linearis tile-indexet. Ld. GpuTileClassifier.Classify().
uint _dispatchGroupsX;
float _seaLevel;
float _climateDayT;
float _orbitalPeriodDays;
float _rotationPeriodDays;
float _axialTiltRad;

// ---- Kimenet ----
RWStructuredBuffer<float> _outElevation;
RWStructuredBuffer<uint> _outIsOceanic;
RWStructuredBuffer<uint> _outBiome;
RWStructuredBuffer<uint> _outIsCratered;

// =====================================================================
// U64 EMULÁCIÓ (uint2: x=Lo, y=Hi) - Threefry4x64-hez
// =====================================================================

uint2 U64Add(uint2 a, uint2 b)
{
    uint lo = a.x + b.x;
    uint carry = lo < a.x ? 1u : 0u;
    uint hi = a.y + b.y + carry;
    return uint2(lo, hi);
}

uint2 U64Xor(uint2 a, uint2 b)
{
    return uint2(a.x ^ b.x, a.y ^ b.y);
}

uint2 U64RotL(uint2 x, int n)
{
    n = n & 63;
    if (n == 0) return x;
    if (n < 32)
    {
        uint newLo = (x.x << n) | (x.y >> (32 - n));
        uint newHi = (x.y << n) | (x.x >> (32 - n));
        return uint2(newLo, newHi);
    }
    else
    {
        int m = n - 32;
        uint swappedLo = x.y;
        uint swappedHi = x.x;
        if (m == 0) return uint2(swappedLo, swappedHi);
        uint newLo = (swappedLo << m) | (swappedHi >> (32 - m));
        uint newHi = (swappedHi << m) | (swappedLo >> (32 - m));
        return uint2(newLo, newHi);
    }
}

static const int THREEFRY_ROT0[8] = { 14, 52, 23, 5, 25, 46, 58, 32 };
static const int THREEFRY_ROT1[8] = { 16, 57, 40, 37, 33, 12, 22, 32 };

// Skein Ks parity: 0x1BD11BDAA9FC1A22 -> Lo=0xA9FC1A22, Hi=0x1BD11BDA
static const uint2 SKEIN_KS_PARITY = uint2(0xA9FC1A22u, 0x1BD11BDAu);

void Threefry4x64(
    uint2 ctr0, uint2 ctr1, uint2 ctr2, uint2 ctr3,
    uint2 key0, uint2 key1, uint2 key2, uint2 key3,
    int rounds,
    out uint2 x0, out uint2 x1, out uint2 x2, out uint2 x3)
{
    uint2 ks[5];
    ks[0] = key0; ks[1] = key1; ks[2] = key2; ks[3] = key3;
    ks[4] = U64Xor(U64Xor(U64Xor(U64Xor(SKEIN_KS_PARITY, ks[0]), ks[1]), ks[2]), ks[3]);

    x0 = U64Add(ctr0, ks[0]);
    x1 = U64Add(ctr1, ks[1]);
    x2 = U64Add(ctr2, ks[2]);
    x3 = U64Add(ctr3, ks[3]);

    for (int r = 0; r < rounds; r++)
    {
        int idx = r & 7;
        int r0v = THREEFRY_ROT0[idx];
        int r1v = THREEFRY_ROT1[idx];

        if ((r & 1) == 0)
        {
            x0 = U64Add(x0, x1); x1 = U64Xor(U64RotL(x1, r0v), x0);
            x2 = U64Add(x2, x3); x3 = U64Xor(U64RotL(x3, r1v), x2);
        }
        else
        {
            x0 = U64Add(x0, x3); x3 = U64Xor(U64RotL(x3, r0v), x0);
            x2 = U64Add(x2, x1); x1 = U64Xor(U64RotL(x1, r1v), x2);
        }

        if ((r & 3) == 3)
        {
            uint injVal = (uint)(r / 4 + 1);
            uint2 injU = uint2(injVal, 0u);
            x0 = U64Add(x0, ks[(injVal + 0) % 5]);
            x1 = U64Add(x1, ks[(injVal + 1) % 5]);
            x2 = U64Add(x2, ks[(injVal + 2) % 5]);
            x3 = U64Add(x3, ks[(injVal + 3) % 5]);
            x3 = U64Add(x3, injU);
        }
    }
}

// =====================================================================
// DeterministicRandom (részleges GPU-port: csak Block/Sample4/SampleUnitVector3)
// =====================================================================

static const uint DOMAIN_TERRAIN = 1u;
static const uint PROPERTY_NOISE_GRADIENT = 2u;
static const uint ALGORITHM_VERSION = 1u;
static const int THREEFRY_DEFAULT_ROUNDS = 20;

void RandomBlock(
    uint domainId, uint2 spatialId, uint2 timeBucket, uint propertyId, uint2 sampleIndex,
    out uint2 x0, out uint2 x1, out uint2 x2, out uint2 x3)
{
    uint2 key1 = uint2(propertyId, domainId); // (domainId<<32)|propertyId -> Lo=propertyId, Hi=domainId
    uint2 key2 = uint2(ALGORITHM_VERSION, 0u);
    uint2 key3 = uint2(0u, 0u);
    uint2 ctr3 = uint2(0u, 0u);
    Threefry4x64(spatialId, timeBucket, sampleIndex, ctr3, _worldSeed, key1, key2, key3, THREEFRY_DEFAULT_ROUNDS, x0, x1, x2, x3);
}

// A CPU "(x >> 11) * 2^-53" (felso 53 bit) helyett a felso 32 bitet
// hasznaljuk - ld. fájl-fejléc 2. pontja.
float SampleTopBits(uint2 block)
{
    return (float)(block.y) * (1.0 / 4294967296.0);
}

float4 Sample4F(uint domainId, uint2 spatialId, uint2 timeBucket, uint propertyId, uint2 sampleIndex)
{
    uint2 x0, x1, x2, x3;
    RandomBlock(domainId, spatialId, timeBucket, propertyId, sampleIndex, x0, x1, x2, x3);
    return float4(SampleTopBits(x0), SampleTopBits(x1), SampleTopBits(x2), SampleTopBits(x3));
}

float3 SampleUnitVector3F(uint domainId, uint2 spatialId, uint2 timeBucket, uint propertyId)
{
    // Elfogadasi arany kb. 52% (pi/6) - 32 iteracio utan a sikertelenseg
    // valoszinusege elhanyagolhato (~0.48^32), biztonsagos GPU-s korlat
    // a CPU-s vegtelen ciklus helyett.
    for (uint i = 0; i < 32; i++)
    {
        float4 s = Sample4F(domainId, spatialId, timeBucket, propertyId, uint2(i, 0u));
        float px = 2.0 * s.x - 1.0;
        float py = 2.0 * s.y - 1.0;
        float pz = 2.0 * s.z - 1.0;
        float lenSq = px * px + py * py + pz * pz;
        if (lenSq > 1e-12 && lenSq <= 1.0)
        {
            float invLen = 1.0 / sqrt(lenSq);
            return float3(px * invLen, py * invLen, pz * invLen);
        }
    }
    return float3(0.0, 0.0, 1.0);
}

// =====================================================================
// DeterministicMath (float32 port - ld. WorldGen.Core.Numerics.DeterministicMath)
// =====================================================================

static const float PI_F = 3.14159265358979323846;
static const float TWO_PI_F = 6.28318530717958647692;
static const float PI_OVER_4_F = 0.78539816339744830962;
static const float LN2_F = 0.69314718055994530941723212145818;
static const float SQRT2_OVER_2_F = 0.70710678118654752440084436210485;

static const float SIN_OCTANT[8] = { 0.0, SQRT2_OVER_2_F, 1.0, SQRT2_OVER_2_F, 0.0, -SQRT2_OVER_2_F, -1.0, -SQRT2_OVER_2_F };
static const float COS_OCTANT[8] = { 1.0, SQRT2_OVER_2_F, 0.0, -SQRT2_OVER_2_F, -1.0, -SQRT2_OVER_2_F, 0.0, SQRT2_OVER_2_F };

float ReduceAngleF(float x)
{
    float revolutions = x / TWO_PI_F;
    float frac = revolutions - floor(revolutions);
    float r = frac * TWO_PI_F;
    if (r >= TWO_PI_F) r -= TWO_PI_F;
    return r;
}

float TaylorSinF(float x)
{
    float x2 = x * x;
    float poly = 1.0 / 6227020800.0;
    poly = -1.0 / 39916800.0 + x2 * poly;
    poly = 1.0 / 362880.0 + x2 * poly;
    poly = -1.0 / 5040.0 + x2 * poly;
    poly = 1.0 / 120.0 + x2 * poly;
    poly = -1.0 / 6.0 + x2 * poly;
    poly = 1.0 + x2 * poly;
    return x * poly;
}

float TaylorCosF(float x)
{
    float x2 = x * x;
    float poly = 1.0 / 479001600.0;
    poly = -1.0 / 3628800.0 + x2 * poly;
    poly = 1.0 / 40320.0 + x2 * poly;
    poly = -1.0 / 720.0 + x2 * poly;
    poly = 1.0 / 24.0 + x2 * poly;
    poly = -1.0 / 2.0 + x2 * poly;
    poly = 1.0 + x2 * poly;
    return poly;
}

void SinCosF(float x, out float sinOut, out float cosOut)
{
    float r = ReduceAngleF(x);
    float kf = round(r / PI_OVER_4_F);
    int k = (int)kf;
    float baseAngle = r - kf * PI_OVER_4_F;
    int kMod = k % 8;
    if (kMod < 0) kMod += 8;

    float sinBase = TaylorSinF(baseAngle);
    float cosBase = TaylorCosF(baseAngle);
    float sinK = SIN_OCTANT[kMod];
    float cosK = COS_OCTANT[kMod];

    sinOut = sinK * cosBase + cosK * sinBase;
    cosOut = cosK * cosBase - sinK * sinBase;
}

void FrexpBitsF(float x, out float m, out int e)
{
    uint bits = asuint(x);
    uint rawExponent = (bits >> 23) & 0xFFu;
    e = (int)rawExponent - 127;
    uint mantissaBits = (bits & 0x007FFFFFu) | (127u << 23);
    m = asfloat(mantissaBits);
}

float ScaleByPowerOfTwoF(float x, int k)
{
    uint bits = asuint(x);
    uint rawExponent = (bits >> 23) & 0xFFu;
    int newExponent = clamp((int)rawExponent + k, 0, 255);
    uint newBits = (bits & 0x807FFFFFu) | ((uint)newExponent << 23);
    return asfloat(newBits);
}

float LnF(float x)
{
    float m; int e;
    FrexpBitsF(x, m, e);
    float y = (m - 1.0) / (m + 1.0);
    float y2 = y * y;
    float poly = 1.0 / 15.0;
    poly = 1.0 / 13.0 + y2 * poly;
    poly = 1.0 / 11.0 + y2 * poly;
    poly = 1.0 / 9.0 + y2 * poly;
    poly = 1.0 / 7.0 + y2 * poly;
    poly = 1.0 / 5.0 + y2 * poly;
    poly = 1.0 / 3.0 + y2 * poly;
    poly = 1.0 + y2 * poly;
    float lnM = 2.0 * y * poly;
    return e * LN2_F + lnM;
}

float ExpF(float x)
{
    float kf = round(x / LN2_F);
    int k = (int)kf;
    float r = x - kf * LN2_F;

    float poly = 1.0 / 3628800.0;
    poly = 1.0 / 362880.0 + r * poly;
    poly = 1.0 / 40320.0 + r * poly;
    poly = 1.0 / 5040.0 + r * poly;
    poly = 1.0 / 720.0 + r * poly;
    poly = 1.0 / 120.0 + r * poly;
    poly = 1.0 / 24.0 + r * poly;
    poly = 1.0 / 6.0 + r * poly;
    poly = 1.0 / 2.0 + r * poly;
    poly = 1.0 + r * poly;
    float expR = 1.0 + r * poly;

    return ScaleByPowerOfTwoF(expR, k);
}

float PowF(float x, float y)
{
    if (x == 0.0) return 0.0;
    return ExpF(y * LnF(x));
}

// =====================================================================
// FractalNoise (float32 port)
// =====================================================================

void PackLatticeF(int ix, int iy, int iz, int octave, out uint2 spatialId, out uint2 timeBucket)
{
    uint ux = (uint)ix;
    uint uy = (uint)iy;
    uint uz = (uint)iz;
    uint uo = (uint)octave;
    spatialId = uint2(uy, ux);   // (ux<<32)|uy -> Lo=uy, Hi=ux
    timeBucket = uint2(uz, uo);  // (uo<<32)|uz -> Lo=uz, Hi=uo
}

float3 LatticeGradientF(int ix, int iy, int iz, int octave)
{
    uint2 spatialId, timeBucket;
    PackLatticeF(ix, iy, iz, octave, spatialId, timeBucket);
    return SampleUnitVector3F(DOMAIN_TERRAIN, spatialId, timeBucket, PROPERTY_NOISE_GRADIENT);
}

float FadeF(float t) { return t * t * t * (t * (t * 6.0 - 15.0) + 10.0); }
float LerpF(float a, float b, float t) { return a + t * (b - a); }

float CornerF(int cx, int cy, int cz, int octave, float dx, float dy, float dz)
{
    float3 g = LatticeGradientF(cx, cy, cz, octave);
    return g.x * dx + g.y * dy + g.z * dz;
}

float GradientNoise3DF(float x, float y, float z, int octave)
{
    int ix0 = (int)floor(x);
    int iy0 = (int)floor(y);
    int iz0 = (int)floor(z);
    int ix1 = ix0 + 1, iy1 = iy0 + 1, iz1 = iz0 + 1;

    float fx = x - ix0, fy = y - iy0, fz = z - iz0;
    float u = FadeF(fx), v = FadeF(fy), w = FadeF(fz);

    float n000 = CornerF(ix0, iy0, iz0, octave, fx, fy, fz);
    float n100 = CornerF(ix1, iy0, iz0, octave, fx - 1, fy, fz);
    float n010 = CornerF(ix0, iy1, iz0, octave, fx, fy - 1, fz);
    float n110 = CornerF(ix1, iy1, iz0, octave, fx - 1, fy - 1, fz);
    float n001 = CornerF(ix0, iy0, iz1, octave, fx, fy, fz - 1);
    float n101 = CornerF(ix1, iy0, iz1, octave, fx - 1, fy, fz - 1);
    float n011 = CornerF(ix0, iy1, iz1, octave, fx, fy - 1, fz - 1);
    float n111 = CornerF(ix1, iy1, iz1, octave, fx - 1, fy - 1, fz - 1);

    float nx00 = LerpF(n000, n100, u);
    float nx10 = LerpF(n010, n110, u);
    float nx01 = LerpF(n001, n101, u);
    float nx11 = LerpF(n011, n111, u);

    float nxy0 = LerpF(nx00, nx10, v);
    float nxy1 = LerpF(nx01, nx11, v);

    return LerpF(nxy0, nxy1, w);
}

float FbmF(float x, float y, float z, float baseFrequency, int octaves, float persistence, float lacunarity)
{
    float total = 0.0;
    float amplitude = 1.0;
    float frequency = baseFrequency;
    float maxAmplitude = 0.0;

    for (int octave = 0; octave < octaves; octave++)
    {
        total += GradientNoise3DF(x * frequency, y * frequency, z * frequency, octave) * amplitude;
        maxAmplitude += amplitude;
        amplitude *= persistence;
        frequency *= lacunarity;
    }
    return total / maxAmplitude;
}

float RidgedMultifractalF(float x, float y, float z, float baseFrequency, int octaves, float persistence, float lacunarity)
{
    float total = 0.0;
    float amplitude = 1.0;
    float frequency = baseFrequency;
    float maxAmplitude = 0.0;

    for (int octave = 0; octave < octaves; octave++)
    {
        float n = GradientNoise3DF(x * frequency, y * frequency, z * frequency, octave);
        float ridged = 1.0 - abs(n);
        ridged *= ridged;
        total += ridged * amplitude;
        maxAmplitude += amplitude;
        amplitude *= persistence;
        frequency *= lacunarity;
    }
    return total / maxAmplitude;
}

// =====================================================================
// DomainWarp (float32 port)
// =====================================================================

static const float OFFSET_DX0 = 7.13, OFFSET_DX1 = 2.71, OFFSET_DX2 = 9.01;
static const float OFFSET_DY0 = 13.37, OFFSET_DY1 = 5.59, OFFSET_DY2 = 1.91;
static const float OFFSET_DZ0 = 4.67, OFFSET_DZ1 = 11.23, OFFSET_DZ2 = 8.05;

float3 WarpPositionF(float3 p)
{
    float dx = FbmF(p.x + OFFSET_DX0, p.y + OFFSET_DX1, p.z + OFFSET_DX2, 2.0, 3, 0.5, 2.0);
    float dy = FbmF(p.x + OFFSET_DY0, p.y + OFFSET_DY1, p.z + OFFSET_DY2, 2.0, 3, 0.5, 2.0);
    float dz = FbmF(p.x + OFFSET_DZ0, p.y + OFFSET_DZ1, p.z + OFFSET_DZ2, 2.0, 3, 0.5, 2.0);

    float3 w = p + float3(dx, dy, dz); // strength = 1.0
    float len_ = length(w);
    if (len_ < 1e-9) return p;
    return w / len_;
}

// =====================================================================
// PlateGeneration / PlateBoundaryEffect / CrustElevation (float32 port)
// =====================================================================

int AssignPlateF(float3 p)
{
    int bestId = -1;
    float bestDot = -1e30;
    for (uint i = 0; i < _plateCount; i++)
    {
        float d = dot(p, _plateSeeds[i]);
        if (d > bestDot) { bestDot = d; bestId = (int)i; }
    }
    return bestId;
}

void TwoBestDotsF(float3 p, out float best, out float second, out int bestIndex, out int secondIndex)
{
    best = -1e30; second = -1e30; bestIndex = -1; secondIndex = -1;
    for (uint i = 0; i < _plateCount; i++)
    {
        float d = dot(p, _plateSeeds[i]);
        if (d > best)
        {
            second = best; secondIndex = bestIndex;
            best = d; bestIndex = (int)i;
        }
        else if (d > second)
        {
            second = d; secondIndex = (int)i;
        }
    }
}

static const float GAP_SCALE = 0.04;
static const float UPLIFT_MAX_M = 1500.0;
static const float OCEANIC_OCEANIC_UPLIFT_FACTOR = 0.15;
static const float MOUNTAIN_MASK_FREQUENCY = 2.5;
static const int MOUNTAIN_MASK_OCTAVES = 3;
static const float MOUNTAIN_MASK_GAIN = 1.3;
static const float MOUNTAIN_MASK_BIAS_POWER = 1.5;

float MountainMaskF(float3 p)
{
    float m = FbmF(p.x, p.y, p.z, MOUNTAIN_MASK_FREQUENCY, MOUNTAIN_MASK_OCTAVES, 0.5, 2.0);
    float normalized = saturate(m * MOUNTAIN_MASK_GAIN + 0.5);
    return PowF(normalized, MOUNTAIN_MASK_BIAS_POWER);
}

float BoundaryUpliftFromWarpedF(float3 rawP, float3 warpedP)
{
    float best, second; int bestIndex, secondIndex;
    TwoBestDotsF(warpedP, best, second, bestIndex, secondIndex);
    float gap = best - second;
    if (gap >= GAP_SCALE) return 0.0;

    float rawUplift = UPLIFT_MAX_M * (1.0 - gap / GAP_SCALE);

    bool bestOceanic = _plateIsOceanic[bestIndex] != 0;
    bool secondOceanic = secondIndex >= 0 && _plateIsOceanic[secondIndex] != 0;
    if (bestOceanic && secondOceanic) rawUplift *= OCEANIC_OCEANIC_UPLIFT_FACTOR;

    float mask = MountainMaskF(rawP);
    return rawUplift * mask;
}

static const float OCEANIC_BASE_M = -4000.0;
static const float CONTINENTAL_BASE_M = 800.0;
static const float NOISE_AMPLITUDE_M = 3000.0;
static const float OCEANIC_NOISE_FACTOR = 0.25;

// ND-52 (docs/04-decisions.md): a CrustElevation.cs CPU-oldali
// BaseElevation-ja MOST MAR egy masodlagos, finom-lepteku reszlet-zajt
// is tartalmaz (SecondaryDetailNoise). EZ A GPU-PORT SZANDEKOSAN NEM
// tartalmazza - KETSZER kiprobalva (elobb 3 oktavval, majd 1 oktavra
// csokkentve + [loop] attributummal), MINDKETSZER "Compiler timed out"
// hibat adott elo Unity-ben a CSGenerateTerrainGeometry kernelre (ez a
// fuggveny szalankent 5x hivja az elevaciot - 1 kozeppont + 4 sarok -
// es a HLSL fordito ezt a mar magaban is 8-oktavos [5 elsodleges + 3
// maszk] szamitast tipikusan teljesen kifejti; barmilyen tovabbi oktav
// hozzaadasa a forditasi-ido koltsegvetes fole tolta). A GPU-port MAR
// ELEVE "gyors kozelites, nem hiteles forras" (ld. fajl-fejlec) - a
// useGpuClassification/useGpuGeometry kapcsolok bekapcsolasakor a GPU-
// uton szamolt elevacio emiatt (DOKUMENTALTAN, SZANDEKOSAN) a finom
// reszlet-zaj nelkul, valamivel simabb, mint a CPU-e - ez elfogadott
// tradeoff, amig a shader-forditasi-ido koltsegvetes nem enged tobbet.
float BaseElevationF(int plateId, float3 p, out bool isOceanic)
{
    isOceanic = _plateIsOceanic[plateId] != 0;
    float baseValue = isOceanic ? OCEANIC_BASE_M : CONTINENTAL_BASE_M;

    float r = RidgedMultifractalF(p.x, p.y, p.z, 8.0, 5, 0.5, 2.0);
    float noise = (r - 0.5) * 2.0;

    float mask = MountainMaskF(p);
    float amplitude = NOISE_AMPLITUDE_M * (isOceanic ? OCEANIC_NOISE_FACTOR : 1.0);

    return baseValue + noise * mask * amplitude;
}

bool IsInsideAnyCraterF(float3 p)
{
    for (uint i = 0; i < _craterCount; i++)
    {
        float4 c = _craters[i];
        if (dot(p, c.xyz) >= c.w) return true;
    }
    return false;
}

float ComputeElevationAtPointF(float3 p)
{
    float3 warped = WarpPositionF(p);
    int plateId = AssignPlateF(warped);

    bool isOceanicUnused;
    float baseElev = BaseElevationF(plateId, p, isOceanicUnused);
    float uplift = BoundaryUpliftFromWarpedF(p, warped);
    float elevation = baseElev + uplift;

    for (uint ci = 0; ci < _craterCount; ci++)
    {
        float4 c = _craters[ci];
        float d = dot(p, c.xyz);
        if (d < c.w) continue;
        float denom = 1.0 - c.w;
        float t = denom > 0.0 ? (d - c.w) / denom : 1.0;
        elevation -= _craterDepths[ci] * t;
    }
    return elevation;
}

// =====================================================================
// OrbitalMechanics / Temperature / BiomeClassification (float32 port)
// =====================================================================

float3 SunDirectionOrbitalFrameF(float t, float orbitalPeriod, float phase0)
{
    float theta = phase0 + 2.0 * PI_F * (t / orbitalPeriod);
    float s, c; SinCosF(theta, s, c);
    return float3(-c, -s, 0.0);
}

// A test-keret <- palya-keret forgatas explicit, komponensenkenti
// kifejtese (NEM mul(float3x3,...) HLSL-matrix-szorzas) - ld. a
// C#-os OrbitalMechanics.BodyOrientationMatrix/SunDirectionBodyFrame
// levezeteset: bodyToOrbital = RotX(tilt)*RotZ(spin), nekunk ennek a
// TRANSZPONALTJA kell (palya -> test). A HLSL mul() sor-/oszlop-major
// konvenciojaba vetett bizalom helyett kezzel kifejtett keplet - igy
// nincs re-transzponalasi kockazat.
float3 SunDirectionBodyFrameF(float t, float orbitalPeriod, float rotationPeriod, float axialTilt, float orbitalPhase0, float rotationPhase0)
{
    float3 s = SunDirectionOrbitalFrameF(t, orbitalPeriod, orbitalPhase0);
    float rotationAngle = rotationPhase0 + 2.0 * PI_F * (t / rotationPeriod);

    float ts, tc; SinCosF(axialTilt, ts, tc);
    float ss, sc; SinCosF(rotationAngle, ss, sc);

    float x = sc * s.x + tc * ss * s.y + ts * ss * s.z;
    float y = -ss * s.x + tc * sc * s.y + ts * sc * s.z;
    float z = tc * s.z - ts * s.y;

    return float3(x, y, z);
}

static const float SIGMA_F = 5.670374419e-8;
static const float F_PEAK_F = 1361.0;
static const float ALBEDO_OCEAN_F = 0.06;
static const float ALBEDO_LAND_F = 0.30;
static const float LAPSE_RATE_F = 0.0065;
static const int NUM_DAY_SAMPLES = 24;
static const float GREENHOUSE_K_F = 33.0;

float DailyAverageInsolationFactorF(float3 p, float dayT, float orbitalPeriod, float rotationPeriod, float axialTilt, float orbitalPhase0, float rotationPhase0)
{
    float total = 0.0;
    for (int i = 0; i < NUM_DAY_SAMPLES; i++)
    {
        float sampleT = dayT + i * (rotationPeriod / NUM_DAY_SAMPLES);
        float3 sunDir = SunDirectionBodyFrameF(sampleT, orbitalPeriod, rotationPeriod, axialTilt, orbitalPhase0, rotationPhase0);
        float cosTheta = dot(p, sunDir);
        total += max(0.0, cosTheta);
    }
    return total / NUM_DAY_SAMPLES;
}

// 2026-09-09 (ND-54): ez a "Simple" hokeplet portja - NEM tartalmaz
// jeg-albedo visszacsatolast/ocean-hopuffert (azok csak a CPU-oldali
// "Full" modellben vannak, Temperature.TemperatureKelvinFull). Sarki
// nyar alatt ez a keplet a polust MELEGEBBNEK szamolja, mint az
// egyenlitot (a Nap sosem nyugszik le ott), ami hibas "Tropical"
// besorolast/szint adhat a polusnal. A CPU-oldal (PlanetGridMesh.
// TemperatureKelvinAt) MAR a Full modellt hasznalja - EZERT a
// `useGpuClassification` scene-beallitas jelenleg KIKAPCSOLVA
// (PlanetView.unity), hogy ez a Simple GPU-port ne fedje at a javitast.
// A Full modell GPU-portolasa (idojaras-zaj + Milankovics-ciklusok +
// 12-mintas oceani atlag) valoszinuleg ujra a mar dokumentalt (ND-52)
// shader-forditasi idotullepest okozna - lasd ND-54 a teljes
// indoklasert.
float TemperatureKelvinF(float3 p, float dayT, float orbitalPeriod, float rotationPeriod, float axialTilt, bool isOceanic, float elevationM, float seaLevelM, float orbitalPhase0, float rotationPhase0)
{
    float avgFactor = DailyAverageInsolationFactorF(p, dayT, orbitalPeriod, rotationPeriod, axialTilt, orbitalPhase0, rotationPhase0);
    float albedo = isOceanic ? ALBEDO_OCEAN_F : ALBEDO_LAND_F;
    float absorbed = F_PEAK_F * avgFactor * (1.0 - albedo);
    float tEq = absorbed > 0.0 ? sqrt(sqrt(absorbed / SIGMA_F)) : 0.0;

    float heightAboveSea = max(0.0, elevationM - seaLevelM);
    float tAltitude = LAPSE_RATE_F * heightAboveSea;

    return tEq + GREENHOUSE_K_F - tAltitude;
}

// Biome enum sorrend megegyezik a C#-os WorldGen.Core.Climate.Biome-mal:
// Ocean=0, SeaIce=1, IceSheet=2, Tundra=3, Temperate=4, Tropical=5.
static const float OCEAN_FREEZING_K = 271.15;
static const float ICE_SHEET_THRESHOLD_K = 263.15;
static const float TUNDRA_THRESHOLD_K = 278.15;
static const float TEMPERATE_THRESHOLD_K = 293.15;

uint ClassifyBiomeF(float temperatureK, bool isOceanic)
{
    if (isOceanic) return temperatureK < OCEAN_FREEZING_K ? 1u : 0u;
    if (temperatureK < ICE_SHEET_THRESHOLD_K) return 2u;
    if (temperatureK < TUNDRA_THRESHOLD_K) return 3u;
    if (temperatureK < TEMPERATE_THRESHOLD_K) return 4u;
    return 5u;
}

// =====================================================================
// Kernel
// =====================================================================

[numthreads(64, 1, 1)]
void CSClassifyTiles(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint linearGroup = groupId.x + groupId.y * _dispatchGroupsX;
    uint i = linearGroup * 64 + groupThreadId.x;
    if (i >= _tileCount) return;

    float3 p = _positions[i];
    float elevation = ComputeElevationAtPointF(p);
    bool isOceanic = elevation < _seaLevel;

    float temperatureK = TemperatureKelvinF(
        p, _climateDayT, _orbitalPeriodDays, _rotationPeriodDays, _axialTiltRad,
        isOceanic, elevation, _seaLevel, 0.0, 0.0);
    uint biome = ClassifyBiomeF(temperatureK, isOceanic);
    bool isCratered = _craterCount > 0 && IsInsideAnyCraterF(p);

    _outElevation[i] = elevation;
    _outIsOceanic[i] = isOceanic ? 1u : 0u;
    _outBiome[i] = biome;
    _outIsCratered[i] = isCratered ? 1u : 0u;
}

// =====================================================================
// M13 Fazis 3: GPU-VEZERELT GEOMETRIA (2026-09-01)
//
// A CSClassifyTiles csak egyetlen pontot (tile-kozepet) klasszifikal - ez
// a kiegeszites egy TELJES negyszog (4 sarok, pozicio+folytonos szin)
// eloallitasat vegzi GPU-n, a mar meglevo ComputeElevationAtPointF/
// TemperatureKelvinF lancra epitve. A CPU-oldal (GpuTerrainGeometryGenerator)
// VISSZAOLVASSA az eredmenyt es a MEGLEVO (mar bevalt) Mesh-epito
// csovezetekbe (AddQuad/BuildMultiMaterialMesh) tolti be - tehat ez NEM
// a teljes zero-masolasos DrawProceduralIndirect ut (az kulon, nagyobb,
// elo Unity-tesztelest igenylo kovetkezo lepes lenne), hanem "csak" a
// DRAGA SZAMITAST viszi at CPU-rol GPU-ra, a mar bevalt renderelesi
// utvonalat valtozatlanul hagyva.
// =====================================================================

// ---- Tovabbi bemenet a geometria-kernelhez ----
// Egy tile leirasa: x=face, y=level, z=u, w=v (mind uint-kent csomagolva).
StructuredBuffer<uint4> _tileDescriptors;
uint _geomTileCount;
uint _geomDispatchGroupsX;
float _radius;          // PlanetGridMesh.radius (Unity-egyseg, NEM meter)
float _elevationScale;  // PlanetGridMesh.elevationScale

// ---- Geometria kimenet: 4 vertex/negyszog, sorrend p00,p10,p11,p01 ----
RWStructuredBuffer<float3> _outVertices;  // count = _geomTileCount*4, UNITY-TERBEN (y/z csere mar megtortent)
RWStructuredBuffer<float3> _outNormals;   // count = _geomTileCount*4
RWStructuredBuffer<float4> _outColors;    // count = _geomTileCount*4 (rgba, a=1)
// A CPU-oldali AdaptiveTileClassification-nak (kategoria/bucket dontesehez)
// megfelelo, tile-KOZEPPONTRA szamolt kiegeszito kimenet - igy a hivo
// oldalnak NEM kell KULON (redundans) CPU-s elevacio-kiertekelest futtatnia
// csak a kategoria eldontesehez.
RWStructuredBuffer<float> _outCenterElevation;  // count = _geomTileCount
RWStructuredBuffer<uint> _outCenterIsOceanic;   // count = _geomTileCount
RWStructuredBuffer<uint> _outCenterBiome;       // count = _geomTileCount

// TileGeometry.PositionFromFaceUV portja (ld. src/WorldGen.Core/Grid/TileGeometry.cs) -
// a "tan-warp" vetites KONSTRUKCIOS/megjelenitesi hasznalatra mar dokumentaltan
// elfogadott (ND-24), itt is csak render-oldali (nem perzisztalt) celra fut.
static const int FACE_NORMAL_AXIS[6] = { 0, 0, 1, 1, 2, 2 };
static const float FACE_NORMAL_SIGN[6] = { 1, -1, 1, -1, 1, -1 };
static const int FACE_RIGHT_AXIS[6] = { 2, 2, 0, 0, 0, 0 };
static const float FACE_RIGHT_SIGN[6] = { -1, 1, 1, 1, 1, -1 };
static const int FACE_UP_AXIS[6] = { 1, 1, 2, 2, 1, 1 };
static const float FACE_UP_SIGN[6] = { 1, 1, 1, -1, 1, 1 };

float3 PositionFromFaceUVF(int face, float uc, float vc)
{
    float wx = tan(uc * PI_OVER_4_F);
    float wy = tan(vc * PI_OVER_4_F);

    // FONTOS: NEM szabad dinamikus indexszel ("p[valtozo] = ...") irni egy
    // float3 vektor komponensebe - ez tobb HLSL-forditoban (pl. FXC)
    // "array reference cannot be used as an l-value; not natively
    // addressable" hibat ad, MERT a `face` csak futasidoben ismert (nem
    // konstans). Ehelyett harom skalar komponenst epitunk fel kulon-kulon,
    // ternary-osszegzessel - matematikailag ekvivalens (normalAxis/
    // rightAxis/upAxis mindig HAROM KULONBOZO tengelyt jelolnek egy adott
    // face-nel, tehat px/py/pz mindegyike pontosan EGY szerepet kap).
    int normalAxis = FACE_NORMAL_AXIS[face];
    float normalSign = FACE_NORMAL_SIGN[face];
    int rightAxis = FACE_RIGHT_AXIS[face];
    float rightSign = FACE_RIGHT_SIGN[face];
    int upAxis = FACE_UP_AXIS[face];
    float upSign = FACE_UP_SIGN[face];

    float px = (normalAxis == 0 ? normalSign : 0.0) + (rightAxis == 0 ? wx * rightSign : 0.0) + (upAxis == 0 ? wy * upSign : 0.0);
    float py = (normalAxis == 1 ? normalSign : 0.0) + (rightAxis == 1 ? wx * rightSign : 0.0) + (upAxis == 1 ? wy * upSign : 0.0);
    float pz = (normalAxis == 2 ? normalSign : 0.0) + (rightAxis == 2 ? wx * rightSign : 0.0) + (upAxis == 2 ? wy * upSign : 0.0);

    return normalize(float3(px, py, pz));
}

// A CPU-s BodyFrameConversion.ToUnity(x,y,z) = (x,z,y) - egyszeru
// tengelycsere, itt kozvetlenul a vegen alkalmazzuk.
float3 ToUnitySpace(float3 coreP) { return float3(coreP.x, coreP.z, coreP.y); }

// ---- Folytonos szin (ld. PlanetGridMesh.cs ContinuousLandBiomeColor/
// ContinuousOceanRockColor/ContinuousWaterColor - PONTOSAN ugyanazok a
// horgony-szinek/kepletek, csak HLSL-be portolva) ----
static const float3 ICE_SHEET_COLOR = float3(0.95, 0.96, 0.98);
static const float3 TUNDRA_COLOR = float3(0.52, 0.52, 0.42);
static const float3 TEMPERATE_COLOR = float3(0.22, 0.52, 0.20);
static const float3 TROPICAL_COLOR = float3(0.78, 0.72, 0.20);
static const float BIOME_BLEND_HALF_WIDTH_K = 4.0;

float SmoothTransition01F(float thresholdK, float temperatureK)
{
    float t = (temperatureK - (thresholdK - BIOME_BLEND_HALF_WIDTH_K)) / (2.0 * BIOME_BLEND_HALF_WIDTH_K);
    t = saturate(t);
    return t * t * (3.0 - 2.0 * t);
}

float3 ContinuousLandBiomeColorF(float temperatureK)
{
    float3 c = lerp(ICE_SHEET_COLOR, TUNDRA_COLOR, SmoothTransition01F(ICE_SHEET_THRESHOLD_K, temperatureK));
    c = lerp(c, TEMPERATE_COLOR, SmoothTransition01F(TUNDRA_THRESHOLD_K, temperatureK));
    c = lerp(c, TROPICAL_COLOR, SmoothTransition01F(TEMPERATE_THRESHOLD_K, temperatureK));
    return c;
}

float3 ContinuousOceanRockColorF(float elevation)
{
    float referenceAmplitude = NOISE_AMPLITUDE_M * OCEANIC_NOISE_FACTOR;
    float normalized = referenceAmplitude > 0.0 ? (elevation - OCEANIC_BASE_M) / referenceAmplitude : 0.0;
    normalized = clamp(normalized, -1.0, 1.0);
    float t = (normalized + 1.0) * 0.5;
    float3 baseColor = float3(0.34, 0.33, 0.30);
    float brightness = lerp(0.82, 1.18, t);
    return saturate(baseColor * brightness);
}

// A sarok (SAJAT elevacioja/pozicioja alapjan levezetett) folytonos
// felszin-szine - ld. PlanetGridMesh.ContinuousCornerColorAuto.
float3 ContinuousCornerColorAutoF(float3 rawP, float elevation, float seaLevel, float dayT, float orbitalPeriod, float rotationPeriod, float axialTilt)
{
    bool isOceanic = elevation < seaLevel;
    if (isOceanic) return ContinuousOceanRockColorF(elevation);
    float temperatureK = TemperatureKelvinF(rawP, dayT, orbitalPeriod, rotationPeriod, axialTilt, isOceanic, elevation, seaLevel, 0.0, 0.0);
    return ContinuousLandBiomeColorF(temperatureK);
}

[numthreads(64, 1, 1)]
void CSGenerateTerrainGeometry(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
    uint linearGroup = groupId.x + groupId.y * _geomDispatchGroupsX;
    uint tileIndex = linearGroup * 64 + groupThreadId.x;
    if (tileIndex >= _geomTileCount) return;

    uint4 desc = _tileDescriptors[tileIndex];
    int face = (int)desc.x;
    int level = (int)desc.y;
    uint u = desc.z;
    uint v = desc.w;

    float n = (float)(1u << level);
    float uMin = (float)u / n * 2.0 - 1.0;
    float uMax = (float)(u + 1u) / n * 2.0 - 1.0;
    float vMin = (float)v / n * 2.0 - 1.0;
    float vMax = (float)(v + 1u) / n * 2.0 - 1.0;

    // Tile-kozeppont klasszifikacio (a CPU-s AdaptiveTileClassification
    // kategoria/isOceanic/biome dontesehez - ld. a bufferek doksijat fent).
    float uCenter = ((float)u + 0.5) / n * 2.0 - 1.0;
    float vCenter = ((float)v + 0.5) / n * 2.0 - 1.0;
    float3 centerDir = PositionFromFaceUVF(face, uCenter, vCenter);
    float centerElevation = ComputeElevationAtPointF(centerDir);
    bool centerIsOceanic = centerElevation < _seaLevel;
    float centerTemperatureK = TemperatureKelvinF(
        centerDir, _climateDayT, _orbitalPeriodDays, _rotationPeriodDays, _axialTiltRad,
        centerIsOceanic, centerElevation, _seaLevel, 0.0, 0.0);
    uint centerBiome = ClassifyBiomeF(centerTemperatureK, centerIsOceanic);
    _outCenterElevation[tileIndex] = centerElevation;
    _outCenterIsOceanic[tileIndex] = centerIsOceanic ? 1u : 0u;
    _outCenterBiome[tileIndex] = centerBiome;

    float3 rawDirs[4];
    rawDirs[0] = PositionFromFaceUVF(face, uMin, vMin); // p00
    rawDirs[1] = PositionFromFaceUVF(face, uMax, vMin); // p10
    rawDirs[2] = PositionFromFaceUVF(face, uMax, vMax); // p11
    rawDirs[3] = PositionFromFaceUVF(face, uMin, vMax); // p01

    float3 displacedUnity[4];
    float3 cornerColors[4];
    for (int k = 0; k < 4; k++)
    {
        float elevation = ComputeElevationAtPointF(rawDirs[k]);
        float displacedRadius = _radius + elevation * _elevationScale;
        float3 dirUnity = ToUnitySpace(rawDirs[k]);
        displacedUnity[k] = dirUnity * displacedRadius;
        cornerColors[k] = ContinuousCornerColorAutoF(
            rawDirs[k], elevation, _seaLevel, _climateDayT, _orbitalPeriodDays, _rotationPeriodDays, _axialTiltRad);
    }

    // Lapos (quad-egesz) normal, ugyanaz a keplet, mint PlanetGridMesh.AddQuad-ban.
    // A Lambert-arnyalast SZANDEKOSAN NEM itt vegezzuk el - a NYERS (arnyalatlan)
    // sarok-szint adjuk vissza, a fenyezes a CPU-oldali, MEGOSZTOTT
    // PlanetGridMesh.AddQuad-ban tortenik, ugyanugy mint a CPU-s EmitAdaptiveTile
    // agon - igy egyetlen helyen van a Lambert-keplet, nincs veszelye a ket ag
    // szet-driftjenek, es nincs dupla-arnyalas kockazata.
    float3 normal = normalize(cross(displacedUnity[1] - displacedUnity[0], displacedUnity[3] - displacedUnity[0]));
    if (dot(normal, displacedUnity[0]) < 0.0) normal = -normal;

    uint outBase = tileIndex * 4u;
    for (int m = 0; m < 4; m++)
    {
        _outVertices[outBase + m] = displacedUnity[m];
        _outNormals[outBase + m] = normal;
        _outColors[outBase + m] = float4(saturate(cornerColors[m]), 1.0);
    }
}
