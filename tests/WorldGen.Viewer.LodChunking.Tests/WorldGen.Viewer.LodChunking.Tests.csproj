<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A viewer LOD-logikaja (unity/WorldGenViewer/Assets/Scripts/Viewer/Lod/)
    SZANDEKOSAN nulla UnityEngine-referenciaval keszul (ld. az asmdef
    noEngineReferences=true beallitasat es a fajlok sajat doksijat), ezert
    kozvetlenul, dotnet alol is tesztelheto Unity Editor nelkul - ez a
    projekt EZT hasznalja ki: a forrasfajlokat LINKKENT (nem masolatkent)
    veszi fel, hogy egyetlen igazsagforras maradjon.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/WorldGen.Core/WorldGen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../unity/WorldGenViewer/Assets/Scripts/Viewer/Lod/DynamicMeshChunking.cs" Link="Source/DynamicMeshChunking.cs" />
  </ItemGroup>

</Project>
